# Server settings for docker compose. Copy to the repo root as .env and fill in.
#
# ============================================================================
# CRYPTO 15-MINUTE DESK (kalshi-bot, package kalshi_bot/): the live loop, the
# paper loop, the recorder, the learner and the dashboard.
# ============================================================================
KALSHI_ENV=prod
KALSHI_API_KEY_ID=
# the key file is mounted at this path by docker-compose.yml; leave as is
KALSHI_PRIVATE_KEY_PATH=/secrets/kalshi-key.txt
KALSHI_DRY_RUN=false
KALSHI_MIN_REQUEST_INTERVAL=0.15
KALSHI_LOG_LEVEL=INFO

# live loop parameters
STRATEGY=fairvalue
MARGIN=0.03
TRADE_DOLLARS=10
LOSS_CAP=50
PROFIT_TARGET=0

# dashboard: the password your phone will type (any username), and the address
# the port is published on. 127.0.0.1 = this server only (SSH tunnel);
# your Tailscale IP (100.x.y.z, from `tailscale ip -4`) = your own devices only.
DASHBOARD_PASSWORD=
DASHBOARD_BIND=127.0.0.1

# ============================================================================
# SPORTS RESEARCH (kalshi-sports, package kalshi_sports/): a separate project
# in this repository. Research only; it places no orders. Everything above
# this line belongs to the crypto 15-minute desk (kalshi-bot, kalshi_bot/).
# ============================================================================
ODDS_API_KEY=
ODDS_API_REGIONS=us,eu
ODDS_INTERVAL=3600
SPORTS_LEAGUES=mlb,nfl,nba,ncaaf,ncaab
