# Copy to .env and fill in. Never commit .env.
# demo  -> https://demo-api.kalshi.co/trade-api/v2   (paper money)
# prod  -> https://api.elections.kalshi.com/trade-api/v2 (real money)
KALSHI_ENV=demo

# From Kalshi -> Account -> API keys. Demo and prod keys are separate.
KALSHI_API_KEY_ID=
# Absolute path to the RSA private key .pem downloaded when the key was created.
# Keep it OUTSIDE this repo, e.g. ~/.kalshi/demo.pem
KALSHI_PRIVATE_KEY_PATH=

# When true, orders are logged but never sent. Default true.
KALSHI_DRY_RUN=true

# Minimum seconds between API requests (rate limiting). Default 0.15.
KALSHI_MIN_REQUEST_INTERVAL=0.15

# Logging level: DEBUG, INFO, WARNING
KALSHI_LOG_LEVEL=INFO
