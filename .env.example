# Copy to .env and fill in. Never commit .env.
# demo  -> https://demo-api.kalshi.co/trade-api/v2   (paper money)
# prod  -> https://api.elections.kalshi.com/trade-api/v2 (real money)
KALSHI_ENV=demo

# From Kalshi -> Account -> API keys. Demo and prod keys are separate.
KALSHI_API_KEY_ID=
# Absolute path to the RSA private key .pem downloaded when the key was created.
# Keep it OUTSIDE this repo, e.g. ~/.kalshi/demo.pem
KALSHI_PRIVATE_KEY_PATH=

# When true, orders are logged but never sent. Default true.
KALSHI_DRY_RUN=true

# Minimum seconds between API requests (rate limiting). Default 0.15.
KALSHI_MIN_REQUEST_INTERVAL=0.15

# Logging level: DEBUG, INFO, WARNING
KALSHI_LOG_LEVEL=INFO

# --- sports (kalshi-sports) ---
# The Odds API key (the-odds-api.com). Optional: without it the sports recorder
# records Kalshi and ESPN only, and the consensus test (H1) cannot run.
ODDS_API_KEY=
# Regions to pull books from; eu adds Pinnacle where the feed carries it.
ODDS_API_REGIONS=us,us2,eu
# Seconds between odds polls per league. 1800 with five leagues is ~7,200
# requests a month; the free tier allows 500, so set 21600 (6 h) on free.
ODDS_INTERVAL=1800
# Leagues to record: mlb, nfl, nba, ncaaf, ncaab
SPORTS_LEAGUES=mlb,nfl,nba,ncaaf,ncaab
